# charter.rules — fapolicyd policy fragment. NOT LIVE AS SHIPPED: the package
# installs it under /usr/share/charter/fapolicyd/ as a reference. It ends in a
# default-deny, so it only ever goes into /etc/fapolicyd/rules.d through the
# opt-in arming step (copy -> seed trust -> `fagenrules --load` -> enable),
# which needs a VM round first: a wrong trust list locks the session out.
#
# Model: default-deny execution. Only binaries charterd has approved (copied
# into the content-addressed store and trusted by sha256) may execute from the
# approved store. charterd manages the trust entries via fapolicyd-cli; this
# fragment pins the store as an allow anchor and keeps the system paths working.
#
# Exact ordering/syntax is validated on the Mint VM (design Spike #1); this is
# the shipped baseline.

# Allow execution of trusted (charterd-approved, hash-pinned) files anywhere.
# Subject left of the colon, object right: "anyone may execute a TRUSTED file".
# This read `trust=1 all : all`, which puts the attribute on the SUBJECT and
# combines it with `all` (fapolicyd.rules(5) forbids that) — at best a parse
# error that rejects the whole fragment, at worst "a trusted process may
# execute anything", i.e. every shell, and no default-deny at all.
allow perm=execute all : trust=1

# Allow execution from the Charter approved-exec store (relocated approved bins).
allow perm=execute all : dir=/var/lib/charter/approved/

# Allow the system flatpak install tree (broker installs here, exec-allowed).
allow perm=execute all : dir=/var/lib/flatpak/

# Everything else that is not trusted is denied by the default-deny tail.
deny_audit perm=execute all : all
