# charterd host configuration — copied to /etc/charter/charterd.env by
# `charter-setup` (which fills in the managed user's real values). Edit if your
# host differs, then `systemctl restart charterd`.

# The managed child's uid — derives the cgroup freeze target (its app.slice).
CHARTER_MANAGED_UID=1000

# Where the on-display lock (charter-lock) draws is resolved LIVE by the
# daemon (kernel active VT -> the Xorg serving it), which is correct under
# user switching (multiple X servers). Only set these on exotic hosts where
# that resolution fails — a pinned :0 targets the wrong X after a user switch:
# CHARTER_DISPLAY=:0
# CHARTER_XAUTHORITY=/home/CHANGEME/.Xauthority

# Optional overrides (defaults are usually right):
# CHARTER_LOCK_BIN=/usr/bin/charter-lock
