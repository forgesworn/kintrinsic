[Unit]
Description=Charter broker spine (org.forgesworn.charterd)
Documentation=https://kintrinsic.app
# NOT ordered after network-online.target: enforcement (roster, freeze, lock,
# budget ticking) needs no network, and the relay work already degrades to
# "nothing delivered" while offline. Waiting for the network left the box
# unenforced for the whole of NetworkManager-wait-online's timeout (30–60 s)
# on any boot without one — and a ward may switch Wi-Fi off and reboot.
# Before the display manager, so enforcement is up before there is a session
# to enforce.
After=dbus.service
Before=display-manager.service
# With Restart=always + RestartSec=2, systemd's default start limit (5 starts
# in 10s) would give up on a persistently crashing charterd and leave the
# service dead — i.e. leave the box permanently thawed by ExecStopPost, which
# is the exact failure Restart=always is here to prevent. Keep retrying; the
# "last enforced at" stamp (see ExecStopPost) is what makes a crash-loop
# VISIBLE to the guardian rather than silent.
StartLimitIntervalSec=0

[Service]
Type=simple
ExecStart=/usr/sbin/charterd
# G5: `Restart=on-failure` does not cover a CLEAN exit, and systemd counts
# SIGTERM as clean — so `kill -TERM` (or anything that sends one during a
# shutdown race) simply left the daemon down, with `ExecStopPost` below having
# thawed the box on the way out. `always` is the only setting that matches what
# the stop hook implies. Two seconds rather than five because every second of
# that window is unenforced desktop.
Restart=always
RestartSec=2
# G5: a charterd that HANGS — a deadlocked executor, a wedged logind call, both
# observed live — is a live process to systemd, so nothing restarted it and
# everything quietly stopped being enforced. The enforcement tick itself sends
# WATCHDOG=1 (`watchdog::ping`), so what is being vouched for is the loop that
# actually does the work, not merely a process that still exists.
#
# 04-G5 — THE BUDGET, and why this is 180 and not 60. The slow tick's network
# section is the long pole: every relay operation carries its own ~8 s timeout,
# and the tick runs one per operation per configured relay. A subscribe + a
# publish across four unreachable relays is already ~64 s of perfectly correct,
# perfectly expected waiting, and a 60 s watchdog killed the daemon for it. That
# kill is not a harmless restart: `ExecStopPost=charter-recovery --thaw-all`
# runs on the way out and unfreezes every managed child, so a bad Wi-Fi night
# became a new fail-open — the exact failure the watchdog exists to prevent,
# caused by the watchdog. 180 s covers the worst realistic network section with
# room to spare while still being far short of an afternoon.
#
# The ceiling is only half of it: `watchdog::ping()` is also sent BEFORE and
# AFTER the network section and between each relay operation inside it
# (`runtime.rs`), so a tick that is merely waiting on relays keeps vouching for
# itself and only a tick that is genuinely STUCK runs the clock out. Raise the
# per-operation timeout or add relays and this number has to be re-derived:
# worst case ≈ (relay timeout) × (relays) × (operations per tick).
WatchdogSec=180
# The keep-alive comes from the main process. (Type=simple does not imply this
# the way Type=notify would, and the unit's Type= is deliberately unchanged.)
NotifyAccess=main
# Lock-out safety: every stop (incl. crash, `systemctl stop`, prerm, the Recovery
# "turn off" action) thaws every managed child's app.slice and re-enables VT
# switching, so a stopped/removed Charter never leaves the box frozen.
ExecStopPost=/usr/sbin/charter-recovery --thaw-all
# Host config (managed uid + the lock screen's display/auth). Written by
# `charter-setup`; optional (the `-` tolerates its absence).
EnvironmentFile=-/etc/charter/charterd.env
# charterd is the sole privileged enactor (cgroup freeze, polkit, fapolicyd,
# system flatpak). It runs as root but drops the obvious ambient privileges it
# does not need; tighten further during the VM hardening pass.
User=root
NoNewPrivileges=false
ProtectSystem=full
# ProtectSystem=full makes /etc read-only. That was harmless while only the
# pkexec'd helpers wrote there, but scan-to-pair has the DAEMON bind the
# guardian's subject into /etc/charter/limits.d — which failed with
# "Read-only file system (os error 30)" on every offer, refusing a pairing
# that was otherwise completely valid. Carve out our own directory ONLY; the
# rest of /etc stays read-only.
ReadWritePaths=/etc/charter
ProtectHome=false
ProtectKernelTunables=true
ProtectControlGroups=false
# Enforcement is DELIBERATELY fail-open on stop (see ExecStopPost above), which
# means the OOM killer choosing charterd hands the ward a thawed window per
# crash cycle. Unreliable as an attack — the kernel picks the memory hog, which
# is the child's browser long before it is a small daemon — but it is one line
# to make charterd close to the last thing on the box to be killed, and the
# alternative is a bypass that arrives by luck rather than by anyone deciding
# it should (review 2026-08-07).
OOMScoreAdjust=-900
# Cheap sandboxing that costs this daemon nothing it uses. charterd freezes
# cgroups, drives polkit/fapolicyd and installs system flatpaks — it does not
# load kernel modules, and it has no business creating namespaces (which is
# also the primitive behind the unprivileged-userns bind-mount exe-ownership
# forgery, 0.7.5).
PrivateTmp=true
ProtectKernelModules=true
RestrictNamespaces=true
RestrictSUIDSGID=true
StateDirectory=charter
RuntimeDirectory=charter

[Install]
WantedBy=multi-user.target
