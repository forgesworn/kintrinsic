#!/bin/sh
# postinst — register charterd with systemd + reload the bus policy. Account
# lockdown is finished by the parent via the "Kintrinsic" menu entry (or
# `charter-setup <user>` headless).
set -e

case "$1" in
    configure)
        systemctl daemon-reload || true
        # Reload D-Bus so the system.d policy for org.forgesworn.charterd applies.
        systemctl reload dbus 2>/dev/null || systemctl reload dbus-broker 2>/dev/null || true
        systemctl enable charterd.service || true
        # restart, not start: an upgrade must swap in the new binary. charterd's
        # startup self-heal (thaw + re-enforce) makes a mid-session restart safe.
        systemctl restart charterd.service || true
        # Rename hygiene: the removed `charter` package leaves its old postrm
        # behind as dpkg residue, and that script deletes /var/lib/charter on
        # purge — which is now OUR live state. Neutralize it so even an
        # accidental `apt purge charter` cannot destroy keys/pairing.
        if [ -f /var/lib/dpkg/info/charter.postrm ]; then
            printf '#!/bin/sh\nexit 0\n' > /var/lib/dpkg/info/charter.postrm
        fi
        # Refresh the menu so the "Kintrinsic" entry appears now.
        update-desktop-database -q 2>/dev/null || true
        # Every systemd call above is `|| true` on purpose (chroot/container
        # builds have no running systemd to talk to), but that means a REAL
        # failure — the new binary refusing to start, `enable` failing — was
        # silently swallowed and we still printed "installed" (04-B11). Check
        # the outcome, only when systemd is actually running, and warn loudly
        # (non-fatal: apt must still finish so a later `dpkg --configure -a`
        # or reinstall can fix it).
        if [ -d /run/systemd/system ]; then
            enabled_ok=1
            active_ok=1
            systemctl is-enabled --quiet charterd.service 2>/dev/null || enabled_ok=0
            systemctl is-active --quiet charterd.service 2>/dev/null || active_ok=0
            if [ "$enabled_ok" -eq 0 ] || [ "$active_ok" -eq 0 ]; then
                echo "kintrinsic: WARNING — charterd did not come up cleanly after install:" >&2
                [ "$enabled_ok" -eq 0 ] && echo "kintrinsic:   - charterd.service is NOT enabled (won't start at boot)" >&2
                [ "$active_ok" -eq 0 ] && echo "kintrinsic:   - charterd.service is NOT active (no enforcement is running right now)" >&2
                echo "kintrinsic:   Screen-time limits are NOT being enforced until this is fixed. Run:" >&2
                echo "kintrinsic:     systemctl status charterd.service" >&2
                echo "kintrinsic:     journalctl -u charterd.service -b" >&2
            fi
        fi
        echo "kintrinsic: installed. Open \"Kintrinsic\" from the menu to choose the child's account and finish."
        ;;
esac

exit 0
