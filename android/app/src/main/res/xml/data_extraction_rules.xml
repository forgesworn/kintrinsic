<?xml version="1.0" encoding="utf-8"?>
<!-- The machine key IS the device identity (port-spec §3.8). It must never
     leave the device via any backup/transfer path — a factory reset destroying
     it is the deliberate no-port re-enrollment property. Exclude everything. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="device_file" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="device_file" />
    </device-transfer>
</data-extraction-rules>
