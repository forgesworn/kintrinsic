.gradle/
build/
local.properties
.cxx/
captures/
# NO exception for debug.keystore (S3, review 2026-08-07). There used to be a
# `!debug.keystore` line here, which meant one `cp ~/.android/debug.keystore .`
# away from committing the key that every deployed ward phone pins its signing
# continuity to. Nothing was ever tracked — it was a loaded gun, not a wound —
# but the debug key is a real signing identity for us, so it is treated like
# one. Builds use the SDK's own `~/.android/debug.keystore`; nothing in this
# tree needs a copy.
*.keystore
.kotlin/
jni/target/
jni-guardian/target/
# cargo-ndk build outputs — regenerated by the CI/build step, never committed.
app/src/main/jniLibs/
carrier/src/main/jniLibs/

# Release signing material — sysadmin-owned deploy secret, never committed.
# See android/keystore/README.md.
*.jks
signing.properties
keystore/*
!keystore/README.md
