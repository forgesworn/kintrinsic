{
  "name": "@forgesworn/charter",
  "version": "0.84.0",
  "description": "Consumer SDK for Charter — parent-led, libre game account management on Nostr. Pairing storage, NIP-46 bunker rehydrate, and clause evaluator for Charter Phase 1α.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "engines": {
    "node": ">=22"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./schedule": {
      "types": "./dist/schedule/index.d.ts",
      "import": "./dist/schedule/index.js"
    },
    "./pairing": {
      "types": "./dist/pairing/index.d.ts",
      "import": "./dist/pairing/index.js"
    },
    "./evaluator": {
      "types": "./dist/evaluator/index.d.ts",
      "import": "./dist/evaluator/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist/",
    "LICENSE",
    "llms.txt"
  ],
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix",
    "prepublishOnly": "npm run build && npm test"
  },
  "homepage": "https://github.com/forgesworn/kintrinsic",
  "keywords": [
    "charter",
    "nostr",
    "parental-controls",
    "signet",
    "nip-46",
    "nip-44",
    "kind-31000",
    "gaming",
    "schedule",
    "typescript"
  ],
  "author": "forgesworn",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/forgesworn/kintrinsic.git"
  },
  "peerDependencies": {
    "nostr-tools": "^2.23.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.0.0",
    "@vitest/coverage-v8": "^4.1.0",
    "eslint": "^10.0.3",
    "fake-indexeddb": "^6.0.0",
    "nostr-tools": "^2.23.3",
    "typescript": "^6.0.2",
    "typescript-eslint": "^8.57.0",
    "vitest": "^4.1.0"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "funding": {
    "type": "lightning",
    "url": "lightning:profusemeat89@walletofsatoshi.com"
  }
}
