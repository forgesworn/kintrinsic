        "allowed": ["org.mozilla.fenix"]
      }
    },
    {
      "name": "blocklist_with_a_live_hold",
      "note": "decented's case: Vanadium stays ON the blocklist and is held open for an hour, so nothing is forgotten when the hour is up. `effectiveBlocked` is what the device must enforce at `effectiveAt`.",
      "input": {
        "enabled": true,
        "posture": "blocklist",
        "blocked": ["org.chromium.vanadium", "com.google.android.youtube"],
        "allowed": [],
        "holds": [
          { "pkg": "org.chromium.vanadium", "state": "allowed", "untilUnix": 1782738000 }
        ]
      },
      "payload": {
        "v": 1,
        "posture": "blocklist",
        "issuedAt": 1782734400,
        "blocked": ["org.chromium.vanadium", "com.google.android.youtube"],
        "holds": [
          { "pkg": "org.chromium.vanadium", "state": "allowed", "untilUnix": 1782738000 }
        ]
      },
      "effectiveAt": 1782734460,
      "effectiveBlocked": ["com.google.android.youtube"],
      "effectiveAllowed": []
    },
    {
