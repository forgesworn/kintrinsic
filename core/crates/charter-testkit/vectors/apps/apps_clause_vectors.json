{
  "note": "Canonical apps (per-app D3) clause vectors — pins MyCharter (TS producer, appsToGrant) ↔ warden (Rust: GrantApps parse). `input` is the app AppsPolicy; `payload` is the wire GrantApps. issuedAt fixed for determinism.",
  "vectors": [
    {
      "name": "blocklist_block_youtube",
      "input": {
        "enabled": true,
        "posture": "blocklist",
        "blocked": ["com.google.android.youtube", "app.meatchat.mobile"],
        "allowed": []
      },
      "payload": {
        "v": 1,
        "posture": "blocklist",
        "issuedAt": 1782734400,
        "blocked": ["com.google.android.youtube", "app.meatchat.mobile"]
      }
    },
